{
  "name": "cypress-timeline",
  "version": "0.2.5",
  "description": "Address- or reference-led rebuild simulations and milestone reports as Web and MP4.",
  "author": {
    "name": "LabCubes",
    "url": "https://github.com/Lab-Cubes"
  },
  "repository": "https://github.com/Lab-Cubes/labcubes-plugin-market",
  "license": "MIT",
  "keywords": [
    "timeline",
    "progress",
    "construction",
    "web",
    "mp4",
    "pixverse",
    "sites",
    "address",
    "rebuild"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "Cypress-timeline",
    "shortDescription": "Web and MP4 progress timelines",
    "longDescription": "Research an Australian address or use site/design references to create hypothetical rebuild timelines. Keep the outer frame stable and export offline HTML or 1080p MP4. Prefer PixVerse for media; support user-selected host image tools for stills and Sites for hosting.",
    "developerName": "LabCubes",
    "category": "Creativity",
    "capabilities": [
      "Interactive",
      "Write"
    ],
    "websiteURL": "https://github.com/Lab-Cubes/labcubes-plugin-market/tree/main/plugins/cypress-timeline",
    "defaultPrompt": [
      "Create a Web and MP4 progress timeline from my starting and finished reference images.",
      "只做离线 HTML，外框固定、主图渐变，支持暂停与节点跳转。"
    ]
  },
  "extensions": {
    "org.labcubes.timeline": {
      "workflowDependencies": [
        {
          "plugin": "pixverse@openai-curated-remote",
          "reviewedVersion": "1.3.3",
          "requiredFor": [
            "pixverse-generation",
            "pixverse-editing"
          ],
          "preferredFor": [
            "new-media",
            "advanced-editing"
          ]
        },
        {
          "plugin": "sites@openai-curated-remote",
          "reviewedVersion": "1.1.0",
          "requiredFor": [
            "hosted-web"
          ]
        }
      ],
      "dependencyInstallation": "workflow-checked; no native auto-installation"
    }
  }
}
